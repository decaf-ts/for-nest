{
  "name": "@decaf-ts/for-nest",
  "version": "0.18.1",
  "description": "NestJS decaf integration",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/types/index.d.mts",
        "default": "./lib/esm/index.js"
      },
      "require": {
        "types": "./lib/types/index.d.cts",
        "default": "./lib/cjs/index.cjs"
      },
      "default": "./lib/esm/index.js"
    },
    "./cli": {
      "import": {
        "types": "./lib/types/cli-module.d.mts",
        "default": "./lib/esm/cli-module.js"
      },
      "require": {
        "types": "./lib/types/cli-module.d.cts",
        "default": "./lib/cjs/cli-module.cjs"
      },
      "default": "./lib/esm/cli-module.js"
    },
    "./webhooks": {
      "import": {
        "types": "./lib/types/webhooks/index.d.mts",
        "default": "./lib/esm/webhooks/index.js"
      },
      "require": {
        "types": "./lib/types/webhooks/index.d.cts",
        "default": "./lib/cjs/webhooks/index.cjs"
      },
      "default": "./lib/esm/webhooks/index.js"
    }
  },
  "bin": {
    "for-nest": "lib/cjs/bin/cli.cjs"
  },
  "types": "./lib/types/index.d.mts",
  "main": "./lib/cjs/index.cjs",
  "module": "./lib/esm/index.js",
  "sideEffects": [
    "./lib/esm/decoration.js",
    "./lib/esm/overrides/index.js",
    "./lib/esm/overrides/overrides.js",
    "./lib/cjs/decoration.cjs",
    "./lib/cjs/overrides/index.cjs",
    "./lib/cjs/overrides/overrides.cjs"
  ],
  "scripts": {
    "do-install": "NPM_TOKEN=$(cat .npmtoken) npm install",
    "update-dependencies": "PREFIX=\"decaf-ts\"; npm ls | grep \"$PREFIX\" | awk -F/ '{print $NF}' | sed 's/@.*//' | xargs -I package npm update @\"$PREFIX\"/package",
    "update-scripts": "npx update-scripts",
    "on-first-run": "npx update-scripts --boot",
    "set-git-auth": "git config url.\"https://api:$(cat .token)@github.com/\".insteadOf \"https://github.com/\" && git config url.\"https://ssh:$(cat .token)@github.com/\".insteadOf \"ssh://git@github.com/\" && git config url.\"https://git:$(cat .token)@github.com/\".insteadOf \"git@github.com:\"",
    "flash-forward": "npx npm-check-updates -u && npm run do-install",
    "reset": "rm -rf * && git checkout . && git pull && npm run do-install",
    "extract:api": "node ./lib/bin/cli.cjs export-api --input ./lib/app.module.js  --output ./ --fileName example-api --title \"Example Swagger API\" --description \"Includes the full Api definition\"",
    "build": "decaf build --dev",
    "build:prod": "decaf build --prod",
    "test": "jest --runInBand --coverage --detectOpenHandles",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --testPathPatterns=\"/tests/unit\" --passWithNoTests --detectOpenHandles",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --testPathPatterns=\"/tests/(integration)\" --passWithNoTests --detectOpenHandles",
    "test:manual": "NODE_OPTIONS=--experimental-vm-modules MANUAL_INSPECT=true MANUAL_INSPECT_TIMEOUT=600000 jest --testPathPatterns=\"/tests/e2e/decaf-model-controller-builder.e2e.ts\" --detectOpenHandles",
    "test:all": "NODE_OPTIONS=--experimental-vm-modules jest --testPathPatterns=\"/tests\" --passWithNoTests --detectOpenHandles",
    "test:circular": "dpdm -T --no-warning --no-tree ./src/index.ts",
    "coverage": "rimraf ./workdocs/reports/data/*.json && npm run test:all -- --coverage --config=./workdocs/reports/jest.coverage.config.cjs",
    "lint": "eslint .",
    "lint-fix": "eslint --fix .",
    "prepare-pr": "npm run build:prod && npm run coverage && npm run docs",
    "prepare-release": "npm run build:prod && npm run coverage && npm run docs",
    "release": "tag-release",
    "clean-publish": "npx clean-publish",
    "drawings": "for FILE in workdocs/drawings/*.drawio; do echo \"converting $FILE to image...\" && docker run --rm -v $(pwd):/data rlespinasse/drawio-export --format png $FILE; done && cp -rf workdocs/drawings/export/* workdocs/resources/",
    "uml": "cd workdocs/uml && for FILE in ./*.puml; do docker run --rm -v $(pwd):/work -w /work miy4/plantuml -DPLANTUML_LIMIT_SIZE=8192 -tpng $FILE; done && cd ../.. && cp -fr workdocs/uml/*.png workdocs/resources/",
    "docs": "npx rimraf ./docs && mkdir docs && decaf build --docs",
    "publish-docs": "docker run -it --rm --user $(id -u):$(id -g) -v \"$(pwd)/workdocs/confluence:/content\" -e ATLASSIAN_API_TOKEN=$(cat .confluence-token) ghcr.io/markdown-confluence/publish:latest",
    "docker:login": "docker login ghcr.io -u $(cat .dockeruser) -p $(cat .dockertoken)",
    "docker:build": "npm run docker:build-base",
    "docker:build-base": "DOCKER_BUILDKIT=1 docker build --secret id=TOKEN,src=$PWD/.npmtoken -t ghcr.io/decaf-ts/ts-workspace:base-$(cat package.json | jq -r '.version') -t ghcr.io/decaf-ts/ts-workspace:base-${VERSION:-latest} -f ./Dockerfile .",
    "docker:publish": "npm run docker:publish-base",
    "docker:publish-base": "docker push ghcr.io/decaf-ts/ts-workspace:base-$(cat package.json | jq -r '.version') && docker push ghcr.io/decaf-ts/ts-workspace:base-${VERSION:-latest}",
    "repo:init": "codex exec \"$(cat ./.codex/prompts/repo-setup.md)\nbase_path is `./`, initialize the repository\"",
    "repo:setup": "codex exec \"$(cat ./.codex/prompts/repo-setup.md)\nbase_path is ./\"",
    "repo:doc": "codex exec \"$(cat ./.codex/prompts/doc.md) $(cat ./.codex/prompts/bulk-docs.md)\nbase_path is ./\"",
    "repo:tests": "codex exec \"$(cat ./.codex/prompts/bulk-tests.md)\nbase_path is ./ and coverage is 95%\" -s workspace-write",
    "prepare-it-tests": "docker compose --project-directory docker up -d --wait",
    "repo:readme": "codex exec \"$(cat ./.codex/prompts/update-readme.md)\nbase_path is ./\"",
    "repo:pr": "npm run repo:doc && npm run repo:tests && npm run repo:readme",
    "sync-codex": "./bin/sync-codex.sh",
    "cli": "node ./lib/bin/cli.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decaf-ts/for-nest.git"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "files": [
    "lib",
    "dist",
    "workdocs/assets/slogans.json"
  ],
  "keywords": [
    "nestjs",
    "routing",
    "http",
    "rest",
    "server",
    "typescript",
    "ts"
  ],
  "author": "Tiago Venceslau and Contributors",
  "license": "MPL-2.0",
  "bugs": {
    "url": "https://github.com/decaf-ts/for-nest/issues"
  },
  "homepage": "https://github.com/decaf-ts/for-nest#readme",
  "devDependencies": {
    "@decaf-ts/cli": "^0.14.0",
    "@decaf-ts/for-fabric": "^0.19.5",
    "@decaf-ts/for-nano": "^0.16.0",
    "@decaf-ts/for-testing": "^1.3.7",
    "@decaf-ts/for-typeorm": "^0.16.0",
    "@decaf-ts/utils": "^2.0.6",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.12",
    "@nestjs/platform-express": "^12.4.0",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/swagger": "^12.1.1",
    "@nestjs/testing": "^12.4.0",
    "@rollup/plugin-replace": "^6.0.3",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.27",
    "commander": "^15.1.0",
    "eventsource": "^5.1.4",
    "supertest": "^7.3.2",
    "typed-array-buffer": "^1.0.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@decaf-ts/core": "^0.34.3",
    "@decaf-ts/db-decorators": "^0.20.0",
    "@decaf-ts/decoration": "^0.20.0",
    "@decaf-ts/decorator-validation": "^1.24.1",
    "@decaf-ts/for-http": "^0.22.0",
    "@decaf-ts/injectable-decorators": "^1.21.1",
    "@decaf-ts/logging": "^0.30.3",
    "@decaf-ts/transactional-decorators": "^0.14.0",
    "@nestjs/common": "^12.4.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "fabric-common": {
      "jsrsasign": "^11.1.0"
    },
    "fabric-ca-client": {
      "jsrsasign": "^11.1.0"
    },
    "ajv": "^8.17.2",
    "@eslint/eslintrc": {
      "ajv": "^6.14.0"
    },
    "eslint": {
      "ajv": "^6.14.0",
      "minimatch": "^11.0.5"
    },
    "multer": "^2.1.2",
    "test-exclude": {
      ".": "^8.0.0",
      "glob": "^14.0.4",
      "minimatch": "^11.0.5"
    },
    "js-yaml": "^5.2.2",
    "brace-expansion": "^5.0.8",
    "@grpc/grpc-js": "^1.14.7",
    "glob": "^14.0.4",
    "minimatch": "^11.0.5",
    "dpdm": {
      "glob": "^14.0.4",
      "minimatch": "^11.0.5"
    },
    "typescript-eslint": {
      "minimatch": "^11.0.5"
    }
  }
}
